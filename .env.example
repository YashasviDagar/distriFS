# =============================================================================
# DistriFS configuration example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env`. Only this example file is tracked in git.
# Every variable below is read from the environment at runtime.
# =============================================================================

# --- Database (metadata only) ------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distrifs?schema=public"

# --- Seed admin account ------------------------------------------------------
SEED_ADMIN_EMAIL="admin@distrifs.local"
SEED_ADMIN_PASSWORD="admin12345"

# --- Security ----------------------------------------------------------------
# Generate strong random values for real deployments.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
# Shared secret for internal service-to-service calls (HMAC).
INTERNAL_SERVICE_TOKEN="replace-with-internal-service-token"
CORS_ORIGIN="http://localhost:3000"

# --- Chunking / replication --------------------------------------------------
CHUNK_SIZE_BYTES=4194304
REPLICATION_FACTOR=2
MAX_FILE_SIZE_BYTES=536870912
UPLOAD_CONCURRENCY=4
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,text/plain,application/octet-stream"

# --- Heartbeat / health / recovery -------------------------------------------
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
HEALTH_SWEEP_INTERVAL_MS=3000
RECOVERY_INTERVAL_MS=10000

# --- Service ports / URLs ----------------------------------------------------
GATEWAY_PORT=8080
METADATA_PORT=8081
METADATA_URL="http://localhost:8081"
NEXT_PUBLIC_API_URL="http://localhost:8080"

# --- Storage node 1 ----------------------------------------------------------
NODE_1_ID="node-1"
NODE_1_HOST="localhost"
NODE_1_PORT=5001
NODE_1_DATA_DIR="storage/node-1/data"
NODE_1_CAPACITY_BYTES=10737418240

# --- Storage node 2 ----------------------------------------------------------
NODE_2_ID="node-2"
NODE_2_HOST="localhost"
NODE_2_PORT=5002
NODE_2_DATA_DIR="storage/node-2/data"
NODE_2_CAPACITY_BYTES=10737418240

# --- Storage node 3 ----------------------------------------------------------
NODE_3_ID="node-3"
NODE_3_HOST="localhost"
NODE_3_PORT=5003
NODE_3_DATA_DIR="storage/node-3/data"
NODE_3_CAPACITY_BYTES=10737418240
